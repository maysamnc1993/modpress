{
    "name": "boxed",
    "title": "هدر باکس‌دار",
    "description": "هدر محدود شده در یک باکس با حاشیه و سایه - طراحی مدرن",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["woocommerce", "search", "sticky", "mega-menu"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "هدر چسبان",
            "default": true,
            "checkbox_label": "فعال کردن حالت Sticky"
        },
        "box_margin": {
            "type": "number",
            "label": "حاشیه باکس (پیکسل)",
            "default": 20,
            "min": 0,
            "max": 60
        },
        "box_margin_top": {
            "type": "number",
            "label": "حاشیه بالا (پیکسل)",
            "default": 20,
            "min": 0,
            "max": 60
        },
        "box_shadow": {
            "type": "select",
            "label": "سایه باکس",
            "default": "medium",
            "options": {
                "none": "بدون سایه",
                "small": "کوچک",
                "medium": "متوسط",
                "large": "بزرگ",
                "xlarge": "خیلی بزرگ"
            }
        },
        "box_radius": {
            "type": "number",
            "label": "شعاع گوشه باکس (پیکسل)",
            "default": 12,
            "min": 0,
            "max": 30
        },
        "box_border": {
            "type": "checkbox",
            "label": "نمایش حاشیه",
            "default": true,
            "checkbox_label": "نمایش خط دور باکس"
        },
        "box_border_color": {
            "type": "color",
            "label": "رنگ حاشیه",
            "default": "#e5e7eb"
        },
        "box_border_width": {
            "type": "number",
            "label": "ضخامت حاشیه (پیکسل)",
            "default": 1,
            "min": 1,
            "max": 5
        },
        "show_search": {
            "type": "checkbox",
            "label": "نمایش جستجو",
            "default": true,
            "checkbox_label": "نمایش آیکون جستجو"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "نمایش سبد خرید",
            "default": true,
            "checkbox_label": "نمایش آیکون سبد خرید"
        },
        "show_account": {
            "type": "checkbox",
            "label": "نمایش حساب کاربری",
            "default": true,
            "checkbox_label": "نمایش آیکون حساب کاربری"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "نمایش علاقه‌مندی‌ها",
            "default": true,
            "checkbox_label": "نمایش آیکون علاقه‌مندی‌ها"
        },
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه باکس",
            "default": "#ffffff"
        },
        "outer_bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه بیرونی",
            "default": "#f9fafb"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#1f2937"
        },
        "menu_hover_color": {
            "type": "color",
            "label": "رنگ هاور منو",
            "default": "#3b82f6"
        },
        "menu_font_weight": {
            "type": "select",
            "label": "وزن فونت منو",
            "default": "medium",
            "options": {
                "normal": "معمولی",
                "medium": "متوسط",
                "semibold": "نیمه‌بولد",
                "bold": "بولد"
            }
        }
    }
}
