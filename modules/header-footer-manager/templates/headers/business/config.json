{
    "name": "business",
    "title": "Business Professional",
    "description": "Professional business header with top bar (contact info, social), logo, navigation, and CTA button",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["sticky", "topbar", "cta"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "Sticky Header",
            "default": true,
            "checkbox_label": "Enable sticky header on scroll"
        },
        "show_topbar": {
            "type": "checkbox",
            "label": "Show Top Bar",
            "default": true,
            "checkbox_label": "Display top bar with contact and social links"
        },
        "topbar_bg_color": {
            "type": "color",
            "label": "Top Bar Background Color",
            "default": "#1e293b"
        },
        "topbar_text_color": {
            "type": "color",
            "label": "Top Bar Text Color",
            "default": "#ffffff"
        },
        "show_search": {
            "type": "checkbox",
            "label": "Show Search",
            "default": true,
            "checkbox_label": "Display search icon"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "Show Cart",
            "default": false,
            "checkbox_label": "Display cart icon (requires WooCommerce)"
        },
        "show_account": {
            "type": "checkbox",
            "label": "Show Account",
            "default": false,
            "checkbox_label": "Display account icon"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "Show Wishlist",
            "default": false,
            "checkbox_label": "Display wishlist icon (requires YITH Wishlist)"
        },
        "bg_color": {
            "type": "color",
            "label": "Header Background Color",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "Header Text Color",
            "default": "#1e293b"
        },
        "show_cta": {
            "type": "checkbox",
            "label": "Show CTA Button",
            "default": true,
            "checkbox_label": "Display call-to-action button"
        },
        "cta_text": {
            "type": "text",
            "label": "CTA Button Text",
            "default": "Get Started"
        },
        "cta_url": {
            "type": "url",
            "label": "CTA Button URL",
            "default": "/contact"
        },
        "cta_style": {
            "type": "select",
            "label": "CTA Button Style",
            "default": "primary",
            "options": {
                "primary": "Primary",
                "secondary": "Secondary",
                "outline": "Outline"
            }
        }
    }
}
