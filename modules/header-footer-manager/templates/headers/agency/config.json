{
    "name": "agency",
    "title": "Creative Agency",
    "description": "Creative agency style with animated menu, portfolio dropdown, and contact button",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["sticky", "mega-menu", "cta"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "Sticky Header",
            "default": true,
            "checkbox_label": "Enable sticky header on scroll"
        },
        "show_topbar": {
            "type": "checkbox",
            "label": "Show Top Bar",
            "default": false,
            "checkbox_label": "Display top bar"
        },
        "topbar_bg_color": {
            "type": "color",
            "label": "Top Bar Background Color",
            "default": "#111827"
        },
        "topbar_text_color": {
            "type": "color",
            "label": "Top Bar Text Color",
            "default": "#ffffff"
        },
        "show_search": {
            "type": "checkbox",
            "label": "Show Search",
            "default": false,
            "checkbox_label": "Display search icon"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "Show Cart",
            "default": false,
            "checkbox_label": "Display cart icon"
        },
        "show_account": {
            "type": "checkbox",
            "label": "Show Account",
            "default": false,
            "checkbox_label": "Display account icon"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "Show Wishlist",
            "default": false,
            "checkbox_label": "Display wishlist icon"
        },
        "bg_color": {
            "type": "color",
            "label": "Header Background Color",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "Header Text Color",
            "default": "#111827"
        },
        "show_cta": {
            "type": "checkbox",
            "label": "Show CTA Button",
            "default": true,
            "checkbox_label": "Display contact/hire us button"
        },
        "cta_text": {
            "type": "text",
            "label": "CTA Button Text",
            "default": "Let's Talk"
        },
        "cta_url": {
            "type": "url",
            "label": "CTA Button URL",
            "default": "/contact"
        },
        "cta_style": {
            "type": "select",
            "label": "CTA Button Style",
            "default": "primary",
            "options": {
                "primary": "Primary",
                "secondary": "Secondary",
                "outline": "Outline"
            }
        }
    }
}
