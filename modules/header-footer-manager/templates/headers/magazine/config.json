{
    "name": "magazine",
    "title": "مجله‌ای",
    "description": "هدر خبری/مجله‌ای با تیکر اخبار، دسته‌بندی و نمایش تاریخ",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["news-ticker", "categories", "date-weather", "sticky"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "هدر چسبان",
            "default": true,
            "checkbox_label": "فعال کردن حالت Sticky"
        },
        "show_topbar": {
            "type": "checkbox",
            "label": "نمایش نوار بالا",
            "default": true,
            "checkbox_label": "نمایش نوار تاریخ و شبکه‌های اجتماعی"
        },
        "topbar_bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه نوار بالا",
            "default": "#dc2626"
        },
        "topbar_text_color": {
            "type": "color",
            "label": "رنگ متن نوار بالا",
            "default": "#ffffff"
        },
        "show_search": {
            "type": "checkbox",
            "label": "نمایش جستجو",
            "default": true,
            "checkbox_label": "نمایش فرم جستجو"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "نمایش سبد خرید",
            "default": false,
            "checkbox_label": "نمایش آیکون سبد خرید"
        },
        "show_account": {
            "type": "checkbox",
            "label": "نمایش حساب کاربری",
            "default": true,
            "checkbox_label": "نمایش آیکون حساب کاربری"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "نمایش علاقه‌مندی‌ها",
            "default": false,
            "checkbox_label": "نمایش آیکون علاقه‌مندی"
        },
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#1e293b"
        },
        "show_cta": {
            "type": "checkbox",
            "label": "نمایش دکمه CTA",
            "default": false,
            "checkbox_label": "نمایش دکمه اقدام"
        },
        "cta_text": {
            "type": "text",
            "label": "متن دکمه CTA",
            "default": "اشتراک"
        },
        "cta_url": {
            "type": "url",
            "label": "لینک دکمه CTA",
            "default": "/subscribe"
        },
        "cta_style": {
            "type": "select",
            "label": "استایل دکمه CTA",
            "options": {
                "primary": "اصلی",
                "secondary": "فرعی",
                "outline": "خطی"
            },
            "default": "primary"
        },
        "show_breaking_news": {
            "type": "checkbox",
            "label": "نمایش تیکر اخبار فوری",
            "default": true,
            "checkbox_label": "نمایش نوار اخبار فوری"
        },
        "breaking_news_label": {
            "type": "text",
            "label": "برچسب اخبار فوری",
            "default": "خبر فوری"
        },
        "show_date": {
            "type": "checkbox",
            "label": "نمایش تاریخ",
            "default": true,
            "checkbox_label": "نمایش تاریخ در نوار بالا"
        },
        "show_weather": {
            "type": "checkbox",
            "label": "نمایش آب و هوا",
            "default": false,
            "checkbox_label": "نمایش اطلاعات آب و هوا"
        },
        "show_categories_bar": {
            "type": "checkbox",
            "label": "نمایش نوار دسته‌بندی",
            "default": true,
            "checkbox_label": "نمایش نوار دسته‌بندی مطالب"
        }
    }
}
