{
    "name": "mega-nav",
    "title": "Mega Navigation",
    "description": "Full-width mega menu header with product category dropdowns showing images and multi-column layouts",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["woocommerce", "mega-menu", "search", "sticky"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "Sticky Header",
            "default": true,
            "checkbox_label": "Enable sticky header on scroll"
        },
        "mega_menu_columns": {
            "type": "select",
            "label": "Mega Menu Columns",
            "default": "4",
            "options": {
                "2": "2 Columns",
                "3": "3 Columns",
                "4": "4 Columns",
                "5": "5 Columns",
                "6": "6 Columns"
            }
        },
        "show_category_images": {
            "type": "checkbox",
            "label": "Show Category Images",
            "default": true,
            "checkbox_label": "Display category images in mega menu"
        },
        "dropdown_animation": {
            "type": "select",
            "label": "Dropdown Animation",
            "default": "fade",
            "options": {
                "fade": "Fade",
                "slide": "Slide Down",
                "scale": "Scale Up"
            }
        },
        "show_search": {
            "type": "checkbox",
            "label": "Show Search",
            "default": true,
            "checkbox_label": "Display search bar"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "Show Cart",
            "default": true,
            "checkbox_label": "Display cart icon"
        },
        "show_account": {
            "type": "checkbox",
            "label": "Show Account",
            "default": true,
            "checkbox_label": "Display account icon"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "Show Wishlist",
            "default": true,
            "checkbox_label": "Display wishlist icon"
        },
        "bg_color": {
            "type": "color",
            "label": "Header Background Color",
            "default": "#ffffff"
        },
        "nav_bg_color": {
            "type": "color",
            "label": "Navigation Background Color",
            "default": "#1e293b"
        },
        "nav_text_color": {
            "type": "color",
            "label": "Navigation Text Color",
            "default": "#ffffff"
        },
        "mega_bg_color": {
            "type": "color",
            "label": "Mega Menu Background Color",
            "default": "#ffffff"
        },
        "mega_border_color": {
            "type": "color",
            "label": "Mega Menu Border Color",
            "default": "#e2e8f0"
        },
        "hover_color": {
            "type": "color",
            "label": "Menu Hover Color",
            "default": "#3b82f6"
        },
        "mega_width": {
            "type": "select",
            "label": "Mega Menu Width",
            "default": "full",
            "options": {
                "full": "Full Width",
                "container": "Container Width",
                "auto": "Auto Width"
            }
        },
        "show_featured_products": {
            "type": "checkbox",
            "label": "Show Featured Products",
            "default": true,
            "checkbox_label": "Display featured products in mega menu"
        }
    }
}
