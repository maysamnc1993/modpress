{
    "name": "category-bar",
    "title": "E-commerce Category Header",
    "description": "E-commerce header with main navigation and horizontal scrolling category bar",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["sticky", "ecommerce", "categories"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "Sticky Header",
            "default": true,
            "checkbox_label": "Enable sticky header on scroll"
        },
        "bg_color": {
            "type": "color",
            "label": "Header Background Color",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "Header Text Color",
            "default": "#000000"
        },
        "show_category_bar": {
            "type": "checkbox",
            "label": "Show Category Bar",
            "default": true,
            "checkbox_label": "Display category navigation bar"
        },
        "category_bar_bg": {
            "type": "color",
            "label": "Category Bar Background",
            "default": "#f9fafb"
        },
        "show_category_icons": {
            "type": "checkbox",
            "label": "Show Category Icons",
            "default": true,
            "checkbox_label": "Display icons for categories"
        },
        "category_bar_style": {
            "type": "select",
            "label": "Category Bar Style",
            "default": "pills",
            "options": {
                "pills": "Pills",
                "underline": "Underline",
                "minimal": "Minimal"
            }
        },
        "show_search": {
            "type": "checkbox",
            "label": "Show Search",
            "default": true,
            "checkbox_label": "Display search bar"
        },
        "search_style": {
            "type": "select",
            "label": "Search Style",
            "default": "expanded",
            "options": {
                "expanded": "Expanded Bar",
                "icon": "Icon Only"
            }
        },
        "show_cart": {
            "type": "checkbox",
            "label": "Show Cart",
            "default": true,
            "checkbox_label": "Display cart icon"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "Show Wishlist",
            "default": true,
            "checkbox_label": "Display wishlist icon"
        },
        "show_account": {
            "type": "checkbox",
            "label": "Show Account",
            "default": true,
            "checkbox_label": "Display account icon"
        },
        "show_compare": {
            "type": "checkbox",
            "label": "Show Compare",
            "default": false,
            "checkbox_label": "Display compare icon"
        },
        "show_phone": {
            "type": "checkbox",
            "label": "Show Phone Number",
            "default": false,
            "checkbox_label": "Display phone number in header"
        },
        "category_hover_color": {
            "type": "color",
            "label": "Category Hover Color",
            "default": "#000000"
        },
        "max_categories": {
            "type": "select",
            "label": "Max Categories to Show",
            "default": "10",
            "options": {
                "5": "5 Categories",
                "10": "10 Categories",
                "15": "15 Categories",
                "all": "All Categories"
            }
        },
        "category_source": {
            "type": "select",
            "label": "Category Source",
            "default": "product",
            "options": {
                "product": "Product Categories",
                "menu": "Custom Menu"
            }
        }
    }
}
