{
    "name": "dual-row",
    "title": "Dual Row Header",
    "description": "Two-row header with top info bar and bottom navigation bar for maximum functionality",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["sticky", "woocommerce", "multi-row"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "Sticky Header",
            "default": true,
            "checkbox_label": "Enable sticky header on scroll"
        },
        "show_row1": {
            "type": "checkbox",
            "label": "Show Top Row",
            "default": true,
            "checkbox_label": "Display top information row"
        },
        "row1_bg_color": {
            "type": "color",
            "label": "Top Row Background Color",
            "default": "#1e293b"
        },
        "row1_text_color": {
            "type": "color",
            "label": "Top Row Text Color",
            "default": "#ffffff"
        },
        "row2_bg_color": {
            "type": "color",
            "label": "Bottom Row Background Color",
            "default": "#ffffff"
        },
        "row2_text_color": {
            "type": "color",
            "label": "Bottom Row Text Color",
            "default": "#000000"
        },
        "show_contact_info": {
            "type": "checkbox",
            "label": "Show Contact Info",
            "default": true,
            "checkbox_label": "Display phone and email in top row"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons in top row"
        },
        "show_language_switcher": {
            "type": "checkbox",
            "label": "Show Language Switcher",
            "default": false,
            "checkbox_label": "Display language switcher"
        },
        "top_row_message": {
            "type": "text",
            "label": "Top Row Message",
            "default": "Free Shipping on Orders Over $50"
        },
        "show_search": {
            "type": "checkbox",
            "label": "Show Search",
            "default": true,
            "checkbox_label": "Display search bar"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "Show Cart",
            "default": true,
            "checkbox_label": "Display cart icon"
        },
        "show_account": {
            "type": "checkbox",
            "label": "Show Account",
            "default": true,
            "checkbox_label": "Display account icon"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "Show Wishlist",
            "default": true,
            "checkbox_label": "Display wishlist icon"
        },
        "sticky_mode": {
            "type": "select",
            "label": "Sticky Mode",
            "default": "both",
            "options": {
                "both": "Both Rows",
                "row2": "Bottom Row Only",
                "none": "No Sticky"
            }
        },
        "show_cta": {
            "type": "checkbox",
            "label": "Show CTA Button",
            "default": true,
            "checkbox_label": "Display call-to-action button"
        },
        "cta_text": {
            "type": "text",
            "label": "CTA Button Text",
            "default": "Get Quote"
        },
        "cta_url": {
            "type": "url",
            "label": "CTA Button URL",
            "default": "/contact"
        }
    }
}
