{
    "name": "multi-level",
    "title": "چند سطحی پیشرفته",
    "description": "هدر با منوی چند سطحی و مگامنو - مناسب سایت‌های بزرگ",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["woocommerce", "search", "sticky", "mega-menu"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "هدر چسبان",
            "default": true,
            "checkbox_label": "فعال کردن حالت Sticky"
        },
        "dropdown_levels": {
            "type": "number",
            "label": "تعداد سطوح منو",
            "default": 3,
            "min": 2,
            "max": 5
        },
        "mega_menu_items": {
            "type": "text",
            "label": "آیتم‌های مگامنو (با کاما جدا کنید)",
            "default": "",
            "placeholder": "محصولات,خدمات"
        },
        "mega_menu_columns": {
            "type": "number",
            "label": "تعداد ستون‌های مگامنو",
            "default": 4,
            "min": 2,
            "max": 6
        },
        "dropdown_width": {
            "type": "number",
            "label": "عرض منوی کشویی (پیکسل)",
            "default": 240,
            "min": 200,
            "max": 400
        },
        "mega_menu_width": {
            "type": "number",
            "label": "عرض مگامنو (پیکسل)",
            "default": 1000,
            "min": 600,
            "max": 1400
        },
        "dropdown_animation": {
            "type": "select",
            "label": "انیمیشن منوی کشویی",
            "default": "fade",
            "options": {
                "fade": "محو شدن",
                "slide": "اسلاید",
                "scale": "بزرگ‌نمایی",
                "none": "بدون انیمیشن"
            }
        },
        "show_icons": {
            "type": "checkbox",
            "label": "نمایش آیکون‌ها",
            "default": true,
            "checkbox_label": "نمایش آیکون‌های منو"
        },
        "show_descriptions": {
            "type": "checkbox",
            "label": "نمایش توضیحات",
            "default": true,
            "checkbox_label": "نمایش توضیحات آیتم‌های منو"
        },
        "show_search": {
            "type": "checkbox",
            "label": "نمایش جستجو",
            "default": true,
            "checkbox_label": "نمایش آیکون جستجو"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "نمایش سبد خرید",
            "default": true,
            "checkbox_label": "نمایش آیکون سبد خرید"
        },
        "show_account": {
            "type": "checkbox",
            "label": "نمایش حساب کاربری",
            "default": true,
            "checkbox_label": "نمایش آیکون حساب کاربری"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "نمایش علاقه‌مندی‌ها",
            "default": true,
            "checkbox_label": "نمایش آیکون علاقه‌مندی‌ها"
        },
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#ffffff"
        },
        "dropdown_bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه منوی کشویی",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#1f2937"
        },
        "hover_color": {
            "type": "color",
            "label": "رنگ هاور",
            "default": "#3b82f6"
        },
        "menu_font_weight": {
            "type": "select",
            "label": "وزن فونت منو",
            "default": "medium",
            "options": {
                "normal": "معمولی",
                "medium": "متوسط",
                "semibold": "نیمه‌بولد",
                "bold": "بولد"
            }
        }
    }
}
