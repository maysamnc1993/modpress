{
    "name": "simple",
    "title": "ساده",
    "description": "هدر ساده و کاربردی - لوگو سمت راست، منو سمت چپ",
    "version": "1.0.0",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#1f2937"
        },
        "show_cta": {
            "type": "checkbox",
            "label": "دکمه CTA",
            "default": false,
            "checkbox_label": "نمایش دکمه تماس"
        },
        "cta_text": {
            "type": "text",
            "label": "متن دکمه",
            "default": "تماس با ما"
        },
        "cta_url": {
            "type": "url",
            "label": "لینک دکمه",
            "default": "/contact"
        }
    }
}
