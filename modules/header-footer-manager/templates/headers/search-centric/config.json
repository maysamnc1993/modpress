{
    "name": "search-centric",
    "title": "Search Centric",
    "description": "Search-focused header with large prominent search bar perfect for ecommerce and content sites",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["woocommerce", "search", "sticky"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "Sticky Header",
            "default": true,
            "checkbox_label": "Enable sticky header on scroll"
        },
        "search_placeholder": {
            "type": "text",
            "label": "Search Placeholder Text",
            "default": "What are you looking for?"
        },
        "search_width": {
            "type": "select",
            "label": "Search Bar Width",
            "default": "lg",
            "options": {
                "md": "Medium (500px)",
                "lg": "Large (600px)",
                "xl": "Extra Large (700px)",
                "full": "Full Width"
            }
        },
        "show_search_suggestions": {
            "type": "checkbox",
            "label": "Show Search Suggestions",
            "default": true,
            "checkbox_label": "Display popular searches below search bar"
        },
        "search_suggestions": {
            "type": "text",
            "label": "Search Suggestions",
            "default": "T-shirts, Shoes, Laptops, Books"
        },
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#000000"
        },
        "search_bg_color": {
            "type": "color",
            "label": "Search Bar Background",
            "default": "#f3f4f6"
        },
        "search_border_color": {
            "type": "color",
            "label": "Search Bar Border Color",
            "default": "#e5e7eb"
        },
        "search_focus_color": {
            "type": "color",
            "label": "Search Bar Focus Color",
            "default": "#3b82f6"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "Show Cart",
            "default": true,
            "checkbox_label": "Display cart icon"
        },
        "show_account": {
            "type": "checkbox",
            "label": "Show Account",
            "default": true,
            "checkbox_label": "Display account icon"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "Show Wishlist",
            "default": false,
            "checkbox_label": "Display wishlist icon"
        },
        "show_categories_menu": {
            "type": "checkbox",
            "label": "Show Categories Menu",
            "default": true,
            "checkbox_label": "Display categories dropdown in search bar"
        },
        "logo_size": {
            "type": "select",
            "label": "Logo Size",
            "default": "sm",
            "options": {
                "xs": "Extra Small",
                "sm": "Small",
                "md": "Medium"
            }
        },
        "search_style": {
            "type": "select",
            "label": "Search Bar Style",
            "default": "rounded",
            "options": {
                "rounded": "Rounded",
                "pill": "Pill (Full Rounded)",
                "square": "Square"
            }
        }
    }
}
