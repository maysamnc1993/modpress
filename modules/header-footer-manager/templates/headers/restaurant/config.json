{
    "name": "restaurant",
    "title": "رستورانی",
    "description": "هدر رستوران با دکمه رزرو، منوی غذا، موقعیت و ساعات کاری",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["reservation", "menu", "location", "hours"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "هدر چسبان",
            "default": false,
            "checkbox_label": "فعال کردن حالت Sticky"
        },
        "show_topbar": {
            "type": "checkbox",
            "label": "نمایش نوار بالا",
            "default": true,
            "checkbox_label": "نمایش نوار اطلاعات تماس و ساعات کاری"
        },
        "topbar_bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه نوار بالا",
            "default": "#0f172a"
        },
        "topbar_text_color": {
            "type": "color",
            "label": "رنگ متن نوار بالا",
            "default": "#ffffff"
        },
        "show_search": {
            "type": "checkbox",
            "label": "نمایش جستجو",
            "default": false,
            "checkbox_label": "نمایش فرم جستجو"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "نمایش سبد خرید",
            "default": true,
            "checkbox_label": "نمایش آیکون سبد خرید (سفارش آنلاین)"
        },
        "show_account": {
            "type": "checkbox",
            "label": "نمایش حساب کاربری",
            "default": true,
            "checkbox_label": "نمایش آیکون حساب کاربری"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "نمایش علاقه‌مندی‌ها",
            "default": false,
            "checkbox_label": "نمایش آیکون علاقه‌مندی"
        },
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#1e293b"
        },
        "show_cta": {
            "type": "checkbox",
            "label": "نمایش دکمه رزرو",
            "default": true,
            "checkbox_label": "نمایش دکمه رزرو میز"
        },
        "cta_text": {
            "type": "text",
            "label": "متن دکمه رزرو",
            "default": "رزرو میز"
        },
        "cta_url": {
            "type": "url",
            "label": "لینک رزرو",
            "default": "/reservation"
        },
        "cta_style": {
            "type": "select",
            "label": "استایل دکمه رزرو",
            "options": {
                "primary": "اصلی",
                "secondary": "فرعی",
                "outline": "خطی"
            },
            "default": "primary"
        },
        "show_menu_button": {
            "type": "checkbox",
            "label": "نمایش دکمه منو",
            "default": true,
            "checkbox_label": "نمایش دکمه مشاهده منو"
        },
        "menu_text": {
            "type": "text",
            "label": "متن دکمه منو",
            "default": "مشاهده منو"
        },
        "menu_url": {
            "type": "url",
            "label": "لینک منو",
            "default": "/menu"
        },
        "show_location": {
            "type": "checkbox",
            "label": "نمایش آدرس",
            "default": true,
            "checkbox_label": "نمایش آدرس در نوار بالا"
        },
        "show_hours": {
            "type": "checkbox",
            "label": "نمایش ساعات کاری",
            "default": true,
            "checkbox_label": "نمایش ساعات کاری در نوار بالا"
        },
        "show_phone": {
            "type": "checkbox",
            "label": "نمایش تلفن",
            "default": true,
            "checkbox_label": "نمایش شماره تماس در نوار بالا"
        }
    }
}
