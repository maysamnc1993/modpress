{
    "name": "split-logo",
    "title": "لوگو مرکزی تقسیم شده",
    "description": "هدر با لوگوی بزرگ در مرکز و منوهای تقسیم شده در دو طرف",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["woocommerce", "search", "sticky", "mega-menu"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "هدر چسبان",
            "default": true,
            "checkbox_label": "فعال کردن حالت Sticky"
        },
        "left_menu_location": {
            "type": "select",
            "label": "موقعیت منوی سمت چپ",
            "default": "primary",
            "options": {
                "primary": "منوی اصلی",
                "secondary": "منوی ثانویه",
                "footer": "منوی فوتر"
            }
        },
        "right_menu_location": {
            "type": "select",
            "label": "موقعیت منوی سمت راست",
            "default": "secondary",
            "options": {
                "primary": "منوی اصلی",
                "secondary": "منوی ثانویه",
                "footer": "منوی فوتر"
            }
        },
        "logo_size": {
            "type": "number",
            "label": "اندازه لوگو (پیکسل)",
            "default": 120,
            "min": 60,
            "max": 200
        },
        "logo_spacing": {
            "type": "number",
            "label": "فاصله اطراف لوگو (پیکسل)",
            "default": 40,
            "min": 20,
            "max": 80
        },
        "show_search": {
            "type": "checkbox",
            "label": "نمایش جستجو",
            "default": true,
            "checkbox_label": "نمایش آیکون جستجو"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "نمایش سبد خرید",
            "default": true,
            "checkbox_label": "نمایش آیکون سبد خرید"
        },
        "show_account": {
            "type": "checkbox",
            "label": "نمایش حساب کاربری",
            "default": true,
            "checkbox_label": "نمایش آیکون حساب کاربری"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "نمایش علاقه‌مندی‌ها",
            "default": true,
            "checkbox_label": "نمایش آیکون علاقه‌مندی‌ها"
        },
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#1f2937"
        },
        "menu_hover_color": {
            "type": "color",
            "label": "رنگ هاور منو",
            "default": "#3b82f6"
        },
        "center_alignment": {
            "type": "checkbox",
            "label": "تراز عمودی مرکزی",
            "default": true,
            "checkbox_label": "تراز کردن همه عناصر به صورت عمودی مرکز"
        },
        "menu_font_size": {
            "type": "number",
            "label": "اندازه فونت منو (پیکسل)",
            "default": 16,
            "min": 12,
            "max": 24
        },
        "menu_font_weight": {
            "type": "select",
            "label": "وزن فونت منو",
            "default": "medium",
            "options": {
                "normal": "معمولی",
                "medium": "متوسط",
                "semibold": "نیمه‌بولد",
                "bold": "بولد"
            }
        },
        "actions_position": {
            "type": "select",
            "label": "موقعیت آیکون‌های اکشن",
            "default": "right",
            "options": {
                "left": "سمت چپ",
                "right": "سمت راست",
                "both": "هر دو طرف"
            }
        }
    }
}
