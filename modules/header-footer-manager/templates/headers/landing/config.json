{
    "name": "landing",
    "title": "صفحه فرود",
    "description": "هدر صفحه فرود با اسکرول هموار، ناوبری چسبان و CTA تبدیل",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["sticky", "smooth-scroll", "conversion-cta", "minimal"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "هدر چسبان",
            "default": true,
            "checkbox_label": "فعال کردن حالت Sticky"
        },
        "show_topbar": {
            "type": "checkbox",
            "label": "نمایش نوار بالا",
            "default": false,
            "checkbox_label": "نمایش نوار اطلاعیه"
        },
        "topbar_bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه نوار بالا",
            "default": "#6366f1"
        },
        "topbar_text_color": {
            "type": "color",
            "label": "رنگ متن نوار بالا",
            "default": "#ffffff"
        },
        "show_search": {
            "type": "checkbox",
            "label": "نمایش جستجو",
            "default": false,
            "checkbox_label": "نمایش فرم جستجو"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "نمایش سبد خرید",
            "default": false,
            "checkbox_label": "نمایش آیکون سبد خرید"
        },
        "show_account": {
            "type": "checkbox",
            "label": "نمایش حساب کاربری",
            "default": true,
            "checkbox_label": "نمایش آیکون حساب کاربری"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "نمایش علاقه‌مندی‌ها",
            "default": false,
            "checkbox_label": "نمایش آیکون علاقه‌مندی"
        },
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#1e293b"
        },
        "show_cta": {
            "type": "checkbox",
            "label": "نمایش دکمه CTA اصلی",
            "default": true,
            "checkbox_label": "نمایش دکمه اقدام اصلی"
        },
        "cta_text": {
            "type": "text",
            "label": "متن دکمه CTA",
            "default": "همین حالا شروع کنید"
        },
        "cta_url": {
            "type": "url",
            "label": "لینک دکمه CTA",
            "default": "#signup"
        },
        "cta_style": {
            "type": "select",
            "label": "استایل دکمه CTA",
            "options": {
                "primary": "اصلی",
                "secondary": "فرعی",
                "outline": "خطی"
            },
            "default": "primary"
        },
        "smooth_scroll": {
            "type": "checkbox",
            "label": "اسکرول هموار",
            "default": true,
            "checkbox_label": "فعال‌سازی اسکرول هموار برای لینک‌های داخلی"
        },
        "transparent_on_top": {
            "type": "checkbox",
            "label": "شفاف در بالای صفحه",
            "default": true,
            "checkbox_label": "هدر شفاف در بالای صفحه"
        },
        "hide_nav_links": {
            "type": "checkbox",
            "label": "مخفی کردن منو",
            "default": false,
            "checkbox_label": "فقط نمایش لوگو و CTA"
        }
    }
}
