{
    "name": "classic",
    "title": "کلاسیک",
    "description": "هدر کلاسیک با لوگو سمت راست و منو سمت چپ - مناسب همه سایت‌ها",
    "version": "2.0.0",
    "author": "Developer Starter",
    "supports": ["woocommerce", "mega-menu", "search", "sticky"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "هدر چسبان",
            "default": true,
            "checkbox_label": "فعال کردن حالت Sticky"
        },
        "show_search": {
            "type": "checkbox",
            "label": "نمایش جستجو",
            "default": true,
            "checkbox_label": "نمایش فرم جستجو در هدر"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "نمایش سبد خرید",
            "default": true,
            "checkbox_label": "نمایش آیکون سبد خرید"
        },
        "show_account": {
            "type": "checkbox",
            "label": "نمایش حساب کاربری",
            "default": true,
            "checkbox_label": "نمایش آیکون حساب کاربری"
        },
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#ffffff"
        }
    }
}
