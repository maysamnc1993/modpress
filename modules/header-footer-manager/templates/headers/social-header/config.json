{
    "name": "social-header",
    "title": "Social-Focused Header",
    "description": "Header design emphasizing social media presence with large icons and optional follower counts",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["sticky", "social", "influencer"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "Sticky Header",
            "default": true,
            "checkbox_label": "Enable sticky header on scroll"
        },
        "bg_color": {
            "type": "color",
            "label": "Header Background Color",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "Header Text Color",
            "default": "#000000"
        },
        "show_follower_count": {
            "type": "checkbox",
            "label": "Show Follower Counts",
            "default": true,
            "checkbox_label": "Display follower/subscriber counts"
        },
        "social_icon_size": {
            "type": "select",
            "label": "Social Icon Size",
            "default": "large",
            "options": {
                "medium": "Medium",
                "large": "Large",
                "xlarge": "Extra Large"
            }
        },
        "social_position": {
            "type": "select",
            "label": "Social Icons Position",
            "default": "center",
            "options": {
                "left": "Left Side",
                "center": "Center",
                "right": "Right Side"
            }
        },
        "social_layout": {
            "type": "select",
            "label": "Social Layout",
            "default": "horizontal",
            "options": {
                "horizontal": "Horizontal",
                "grid": "Grid"
            }
        },
        "show_social_labels": {
            "type": "checkbox",
            "label": "Show Platform Labels",
            "default": true,
            "checkbox_label": "Display platform names below icons"
        },
        "social_hover_effect": {
            "type": "select",
            "label": "Hover Effect",
            "default": "scale",
            "options": {
                "scale": "Scale Up",
                "color": "Color Change",
                "lift": "Lift Effect"
            }
        },
        "show_menu": {
            "type": "checkbox",
            "label": "Show Navigation Menu",
            "default": true,
            "checkbox_label": "Display navigation menu"
        },
        "menu_position": {
            "type": "select",
            "label": "Menu Position",
            "default": "below",
            "options": {
                "above": "Above Social Icons",
                "below": "Below Social Icons"
            }
        },
        "show_search": {
            "type": "checkbox",
            "label": "Show Search",
            "default": false,
            "checkbox_label": "Display search icon"
        },
        "instagram_followers": {
            "type": "text",
            "label": "Instagram Followers",
            "default": "10.5K"
        },
        "facebook_followers": {
            "type": "text",
            "label": "Facebook Followers",
            "default": "8.2K"
        },
        "youtube_followers": {
            "type": "text",
            "label": "YouTube Subscribers",
            "default": "5.1K"
        },
        "twitter_followers": {
            "type": "text",
            "label": "Twitter Followers",
            "default": "12.3K"
        },
        "tiktok_followers": {
            "type": "text",
            "label": "TikTok Followers",
            "default": "15.7K"
        },
        "social_bg_color": {
            "type": "color",
            "label": "Social Icons Background",
            "default": "#f3f4f6"
        },
        "social_hover_color": {
            "type": "color",
            "label": "Social Icons Hover Color",
            "default": "#000000"
        }
    }
}
