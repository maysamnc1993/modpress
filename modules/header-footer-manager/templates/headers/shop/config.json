{
    "name": "shop",
    "title": "E-commerce Shop",
    "description": "E-commerce optimized with categories dropdown, search prominent, cart with count, wishlist, and account",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["woocommerce", "sticky", "topbar", "search", "cart", "wishlist"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "Sticky Header",
            "default": true,
            "checkbox_label": "Enable sticky header on scroll"
        },
        "show_topbar": {
            "type": "checkbox",
            "label": "Show Top Bar",
            "default": true,
            "checkbox_label": "Display top bar with promotions and contact"
        },
        "topbar_bg_color": {
            "type": "color",
            "label": "Top Bar Background Color",
            "default": "#2563eb"
        },
        "topbar_text_color": {
            "type": "color",
            "label": "Top Bar Text Color",
            "default": "#ffffff"
        },
        "show_search": {
            "type": "checkbox",
            "label": "Show Search",
            "default": true,
            "checkbox_label": "Display prominent search bar"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "Show Cart",
            "default": true,
            "checkbox_label": "Display shopping cart icon"
        },
        "show_account": {
            "type": "checkbox",
            "label": "Show Account",
            "default": true,
            "checkbox_label": "Display account/login icon"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "Show Wishlist",
            "default": true,
            "checkbox_label": "Display wishlist icon"
        },
        "bg_color": {
            "type": "color",
            "label": "Header Background Color",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "Header Text Color",
            "default": "#1f2937"
        },
        "show_cta": {
            "type": "checkbox",
            "label": "Show CTA Button",
            "default": false,
            "checkbox_label": "Display call-to-action button"
        },
        "cta_text": {
            "type": "text",
            "label": "CTA Button Text",
            "default": "Shop Now"
        },
        "cta_url": {
            "type": "url",
            "label": "CTA Button URL",
            "default": "/shop"
        },
        "cta_style": {
            "type": "select",
            "label": "CTA Button Style",
            "default": "primary",
            "options": {
                "primary": "Primary",
                "secondary": "Secondary",
                "outline": "Outline"
            }
        }
    }
}
