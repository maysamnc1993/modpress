{
    "name": "shop",
    "title": "فروشگاهی",
    "description": "هدر مناسب فروشگاه - با سبد خرید، جستجو و حساب کاربری",
    "version": "1.0.0",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#1f2937"
        },
        "show_search": {
            "type": "checkbox",
            "label": "جستجو",
            "default": true,
            "checkbox_label": "نمایش فیلد جستجو"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "سبد خرید",
            "default": true,
            "checkbox_label": "نمایش آیکون سبد خرید"
        },
        "show_account": {
            "type": "checkbox",
            "label": "حساب کاربری",
            "default": true,
            "checkbox_label": "نمایش آیکون حساب کاربری"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "علاقه‌مندی‌ها",
            "default": false,
            "checkbox_label": "نمایش آیکون علاقه‌مندی‌ها"
        },
        "sticky": {
            "type": "checkbox",
            "label": "هدر چسبان",
            "default": false,
            "checkbox_label": "ثابت هنگام اسکرول"
        }
    }
}
