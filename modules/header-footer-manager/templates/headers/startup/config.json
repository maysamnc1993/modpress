{
    "name": "startup",
    "title": "استارتاپی",
    "description": "هدر مدرن استارتاپی با گرادیانت، دکمه دمو و لینک قیمت‌گذاری",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["sticky", "gradient", "video-cta", "modern"],
    "settings": {
        "sticky": {
            "type": "checkbox",
            "label": "هدر چسبان",
            "default": true,
            "checkbox_label": "فعال کردن حالت Sticky"
        },
        "show_topbar": {
            "type": "checkbox",
            "label": "نمایش نوار بالا",
            "default": true,
            "checkbox_label": "نمایش نوار اطلاعیه"
        },
        "topbar_bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه نوار بالا",
            "default": "#8b5cf6"
        },
        "topbar_text_color": {
            "type": "color",
            "label": "رنگ متن نوار بالا",
            "default": "#ffffff"
        },
        "show_search": {
            "type": "checkbox",
            "label": "نمایش جستجو",
            "default": false,
            "checkbox_label": "نمایش فرم جستجو"
        },
        "show_cart": {
            "type": "checkbox",
            "label": "نمایش سبد خرید",
            "default": false,
            "checkbox_label": "نمایش آیکون سبد خرید"
        },
        "show_account": {
            "type": "checkbox",
            "label": "نمایش حساب کاربری",
            "default": true,
            "checkbox_label": "نمایش آیکون حساب کاربری"
        },
        "show_wishlist": {
            "type": "checkbox",
            "label": "نمایش علاقه‌مندی‌ها",
            "default": false,
            "checkbox_label": "نمایش آیکون علاقه‌مندی"
        },
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#1e293b"
        },
        "show_cta": {
            "type": "checkbox",
            "label": "نمایش دکمه CTA اصلی",
            "default": true,
            "checkbox_label": "نمایش دکمه اقدام اصلی"
        },
        "cta_text": {
            "type": "text",
            "label": "متن دکمه CTA",
            "default": "شروع رایگان"
        },
        "cta_url": {
            "type": "url",
            "label": "لینک دکمه CTA",
            "default": "/signup"
        },
        "cta_style": {
            "type": "select",
            "label": "استایل دکمه CTA",
            "options": {
                "primary": "اصلی",
                "secondary": "فرعی",
                "outline": "خطی"
            },
            "default": "primary"
        },
        "show_demo_cta": {
            "type": "checkbox",
            "label": "نمایش دکمه دمو",
            "default": true,
            "checkbox_label": "نمایش دکمه مشاهده دمو"
        },
        "demo_text": {
            "type": "text",
            "label": "متن دکمه دمو",
            "default": "مشاهده دمو"
        },
        "demo_url": {
            "type": "url",
            "label": "لینک دمو",
            "default": "/demo"
        },
        "show_pricing_link": {
            "type": "checkbox",
            "label": "نمایش لینک قیمت‌گذاری",
            "default": true,
            "checkbox_label": "نمایش لینک قیمت‌گذاری در منو"
        },
        "gradient_enabled": {
            "type": "checkbox",
            "label": "فعال‌سازی گرادیانت",
            "default": true,
            "checkbox_label": "استفاده از پس‌زمینه گرادیانت"
        }
    }
}
