{
    "name": "mega-footer",
    "title": "Mega Footer",
    "description": "Large multi-section footer with everything - newsletter, app buttons, trust badges, payment icons",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "columns": {
            "type": "select",
            "label": "Number of Columns",
            "default": "4",
            "options": {
                "3": "3 Columns",
                "4": "4 Columns",
                "5": "5 Columns",
                "6": "6 Columns"
            }
        },
        "show_newsletter_bar": {
            "type": "checkbox",
            "label": "Show Newsletter Bar",
            "default": true,
            "checkbox_label": "Display newsletter subscription bar at top"
        },
        "newsletter_bg_color": {
            "type": "color",
            "label": "Newsletter Background Color",
            "default": "#3b82f6"
        },
        "newsletter_text": {
            "type": "text",
            "label": "Newsletter Heading",
            "default": "Subscribe to our Newsletter"
        },
        "newsletter_description": {
            "type": "textarea",
            "label": "Newsletter Description",
            "default": "Get the latest updates, offers, and exclusive content delivered to your inbox"
        },
        "show_app_buttons": {
            "type": "checkbox",
            "label": "Show App Download Buttons",
            "default": true,
            "checkbox_label": "Display iOS and Android download buttons"
        },
        "ios_link": {
            "type": "url",
            "label": "iOS App Store Link",
            "default": "#"
        },
        "android_link": {
            "type": "url",
            "label": "Android Play Store Link",
            "default": "#"
        },
        "show_trust_badges": {
            "type": "checkbox",
            "label": "Show Trust Badges",
            "default": true,
            "checkbox_label": "Display security and trust badges"
        },
        "show_payment_icons": {
            "type": "checkbox",
            "label": "Show Payment Icons",
            "default": true,
            "checkbox_label": "Display payment method icons"
        },
        "bg_color": {
            "type": "color",
            "label": "Footer Background Color",
            "default": "#111827"
        },
        "text_color": {
            "type": "color",
            "label": "Footer Text Color",
            "default": "#d1d5db"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#ffffff"
        },
        "link_hover_color": {
            "type": "color",
            "label": "Link Hover Color",
            "default": "#3b82f6"
        },
        "bottom_bg_color": {
            "type": "color",
            "label": "Bottom Bar Background Color",
            "default": "#0f172a"
        },
        "show_working_hours": {
            "type": "checkbox",
            "label": "Show Working Hours",
            "default": true,
            "checkbox_label": "Display business working hours"
        },
        "working_hours_text": {
            "type": "textarea",
            "label": "Working Hours Text",
            "default": "Monday - Friday: 9:00 AM - 6:00 PM\nSaturday: 10:00 AM - 4:00 PM\nSunday: Closed"
        }
    }
}
