{
    "name": "app-download",
    "title": "App Download Footer",
    "description": "App download focused footer with large app mockup, store buttons, and QR code",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "app_image": {
            "type": "text",
            "label": "App Image URL",
            "default": ""
        },
        "show_qr_code": {
            "type": "checkbox",
            "label": "Show QR Code",
            "default": true,
            "checkbox_label": "Display QR code for app download"
        },
        "qr_code_image": {
            "type": "text",
            "label": "QR Code Image URL",
            "default": ""
        },
        "ios_link": {
            "type": "url",
            "label": "iOS App Store Link",
            "default": "#"
        },
        "android_link": {
            "type": "url",
            "label": "Android Play Store Link",
            "default": "#"
        },
        "show_web_app": {
            "type": "checkbox",
            "label": "Show Web App Button",
            "default": false,
            "checkbox_label": "Display web app launch button"
        },
        "web_app_link": {
            "type": "url",
            "label": "Web App URL",
            "default": "#"
        },
        "app_heading": {
            "type": "text",
            "label": "App Section Heading",
            "default": "Download Our Mobile App"
        },
        "app_description": {
            "type": "textarea",
            "label": "App Section Description",
            "default": "Experience our platform on the go. Download our mobile app for iOS and Android devices."
        },
        "show_features": {
            "type": "checkbox",
            "label": "Show App Features",
            "default": true,
            "checkbox_label": "Display app features list"
        },
        "bg_color": {
            "type": "color",
            "label": "Footer Background Color",
            "default": "#0f172a"
        },
        "text_color": {
            "type": "color",
            "label": "Footer Text Color",
            "default": "#e2e8f0"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#ffffff"
        },
        "accent_color": {
            "type": "color",
            "label": "Accent Color",
            "default": "#3b82f6"
        },
        "app_section_bg": {
            "type": "color",
            "label": "App Section Background Color",
            "default": "#1e293b"
        },
        "bottom_bg_color": {
            "type": "color",
            "label": "Bottom Bar Background Color",
            "default": "#020617"
        },
        "show_stats": {
            "type": "checkbox",
            "label": "Show App Stats",
            "default": true,
            "checkbox_label": "Display download stats/ratings"
        }
    }
}
