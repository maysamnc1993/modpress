{
    "name": "contact-focused",
    "title": "Contact Focused Footer",
    "description": "Large contact section footer with form, map, working hours, and detailed contact info",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "show_contact_form": {
            "type": "checkbox",
            "label": "Show Contact Form",
            "default": true,
            "checkbox_label": "Display contact form in footer"
        },
        "form_style": {
            "type": "select",
            "label": "Form Style",
            "default": "inline",
            "options": {
                "inline": "Inline (Horizontal)",
                "stacked": "Stacked (Vertical)",
                "minimal": "Minimal"
            }
        },
        "show_map": {
            "type": "checkbox",
            "label": "Show Map Placeholder",
            "default": true,
            "checkbox_label": "Display map placeholder area"
        },
        "map_embed_code": {
            "type": "textarea",
            "label": "Map Embed Code",
            "default": ""
        },
        "show_working_hours": {
            "type": "checkbox",
            "label": "Show Working Hours",
            "default": true,
            "checkbox_label": "Display working hours"
        },
        "working_hours": {
            "type": "textarea",
            "label": "Working Hours",
            "default": "Monday - Friday: 9:00 AM - 6:00 PM\nSaturday: 10:00 AM - 4:00 PM\nSunday: Closed"
        },
        "bg_color": {
            "type": "color",
            "label": "Footer Background Color",
            "default": "#f8fafc"
        },
        "text_color": {
            "type": "color",
            "label": "Footer Text Color",
            "default": "#334155"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#0f172a"
        },
        "accent_color": {
            "type": "color",
            "label": "Accent Color",
            "default": "#3b82f6"
        },
        "form_bg_color": {
            "type": "color",
            "label": "Form Background Color",
            "default": "#ffffff"
        },
        "bottom_bg_color": {
            "type": "color",
            "label": "Bottom Bar Background Color",
            "default": "#e2e8f0"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        },
        "contact_heading": {
            "type": "text",
            "label": "Contact Section Heading",
            "default": "Get in Touch"
        },
        "contact_description": {
            "type": "textarea",
            "label": "Contact Section Description",
            "default": "We'd love to hear from you. Reach out to us for any questions, comments, or concerns."
        },
        "show_phone": {
            "type": "checkbox",
            "label": "Show Phone Number",
            "default": true,
            "checkbox_label": "Display phone number"
        },
        "show_email": {
            "type": "checkbox",
            "label": "Show Email",
            "default": true,
            "checkbox_label": "Display email address"
        }
    }
}
