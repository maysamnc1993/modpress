{
    "name": "standard",
    "title": "استاندارد",
    "description": "فوتر کامل با ستون‌های ویجت، لوگو و کپی‌رایت",
    "version": "1.0.0",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#111827"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#9ca3af"
        },
        "show_logo": {
            "type": "checkbox",
            "label": "نمایش لوگو",
            "default": true,
            "checkbox_label": "نمایش لوگو در فوتر"
        },
        "description": {
            "type": "textarea",
            "label": "توضیحات",
            "default": "یک توضیح کوتاه درباره کسب‌وکار شما."
        },
        "columns": {
            "type": "select",
            "label": "تعداد ستون‌ها",
            "default": "4",
            "options": {
                "2": "۲ ستون",
                "3": "۳ ستون",
                "4": "۴ ستون"
            }
        },
        "show_socials": {
            "type": "checkbox",
            "label": "شبکه‌های اجتماعی",
            "default": true,
            "checkbox_label": "نمایش آیکون‌ها"
        },
        "copyright_text": {
            "type": "text",
            "label": "متن کپی‌رایت",
            "default": "تمامی حقوق محفوظ است."
        }
    }
}
