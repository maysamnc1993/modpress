{
    "name": "faq",
    "title": "FAQ Footer",
    "description": "Footer with FAQ accordion section and contact CTA",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#374151"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#111827"
        },
        "accent_color": {
            "type": "color",
            "label": "Accent Color",
            "default": "#3b82f6"
        },
        "border_color": {
            "type": "color",
            "label": "Border Color",
            "default": "#e5e7eb"
        },
        "faq_count": {
            "type": "number",
            "label": "Number of FAQ Items",
            "default": "5",
            "min": "3",
            "max": "10"
        },
        "faq_style": {
            "type": "select",
            "label": "FAQ Display Style",
            "default": "accordion",
            "options": {
                "accordion": "Accordion (Expandable)",
                "list": "Simple List"
            }
        },
        "show_contact_cta": {
            "type": "checkbox",
            "label": "Show Contact CTA",
            "default": true,
            "checkbox_label": "Display contact call-to-action section"
        },
        "cta_heading": {
            "type": "text",
            "label": "CTA Heading",
            "default": "Still Have Questions?"
        },
        "cta_text": {
            "type": "textarea",
            "label": "CTA Text",
            "default": "Our team is here to help. Get in touch and we'll answer any questions you may have."
        },
        "cta_button_text": {
            "type": "text",
            "label": "CTA Button Text",
            "default": "Contact Us"
        },
        "show_logo": {
            "type": "checkbox",
            "label": "Show Logo",
            "default": true,
            "checkbox_label": "Display logo in footer"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "Show Copyright",
            "default": true,
            "checkbox_label": "Display copyright text"
        },
        "copyright_text": {
            "type": "text",
            "label": "Custom Copyright Text",
            "default": "All rights reserved."
        },
        "spacing_top": {
            "type": "select",
            "label": "Top Spacing",
            "default": "large",
            "options": {
                "none": "None",
                "small": "Small",
                "medium": "Medium",
                "large": "Large"
            }
        },
        "spacing_bottom": {
            "type": "select",
            "label": "Bottom Spacing",
            "default": "medium",
            "options": {
                "none": "None",
                "small": "Small",
                "medium": "Medium",
                "large": "Large"
            }
        }
    }
}
