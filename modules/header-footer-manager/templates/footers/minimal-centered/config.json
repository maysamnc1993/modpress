{
    "name": "minimal-centered",
    "title": "Minimal Centered Footer",
    "description": "Ultra minimal centered footer with logo, social, and copyright",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#6b7280"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#111827"
        },
        "accent_color": {
            "type": "color",
            "label": "Accent Color",
            "default": "#3b82f6"
        },
        "border_color": {
            "type": "color",
            "label": "Border Color",
            "default": "#e5e7eb"
        },
        "layout": {
            "type": "select",
            "label": "Layout Style",
            "default": "stacked",
            "options": {
                "single-line": "Single Line (Horizontal)",
                "stacked": "Stacked (Vertical)"
            }
        },
        "show_logo": {
            "type": "checkbox",
            "label": "Show Logo",
            "default": true,
            "checkbox_label": "Display logo"
        },
        "show_tagline": {
            "type": "checkbox",
            "label": "Show Tagline",
            "default": true,
            "checkbox_label": "Display site tagline below logo"
        },
        "custom_tagline": {
            "type": "text",
            "label": "Custom Tagline",
            "default": ""
        },
        "show_menu": {
            "type": "checkbox",
            "label": "Show Menu",
            "default": true,
            "checkbox_label": "Display navigation menu"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        },
        "social_style": {
            "type": "select",
            "label": "Social Icons Style",
            "default": "simple",
            "options": {
                "simple": "Simple Icons",
                "rounded": "Rounded Background",
                "outlined": "Outlined Circle"
            }
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "Show Copyright",
            "default": true,
            "checkbox_label": "Display copyright text"
        },
        "copyright_text": {
            "type": "text",
            "label": "Custom Copyright Text",
            "default": ""
        },
        "spacing": {
            "type": "select",
            "label": "Vertical Spacing",
            "default": "medium",
            "options": {
                "compact": "Compact",
                "medium": "Medium",
                "relaxed": "Relaxed"
            }
        },
        "show_divider": {
            "type": "checkbox",
            "label": "Show Top Divider",
            "default": true,
            "checkbox_label": "Display divider line at top"
        },
        "divider_style": {
            "type": "select",
            "label": "Divider Style",
            "default": "simple",
            "options": {
                "simple": "Simple Line",
                "gradient": "Gradient Fade",
                "dots": "Dots"
            }
        },
        "text_size": {
            "type": "select",
            "label": "Text Size",
            "default": "normal",
            "options": {
                "small": "Small",
                "normal": "Normal",
                "large": "Large"
            }
        }
    }
}
