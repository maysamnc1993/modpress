{
    "name": "partner-logos",
    "title": "Partner Logos Footer",
    "description": "Footer with partner/client logos carousel or grid section",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        "logos_bg": {
            "type": "color",
            "label": "Logos Section Background",
            "default": "#f1f5f9"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#475569"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#1e293b"
        },
        "accent_color": {
            "type": "color",
            "label": "Accent Color",
            "default": "#10b981"
        },
        "show_logos": {
            "type": "checkbox",
            "label": "Show Partner Logos",
            "default": true,
            "checkbox_label": "Display partner logos section"
        },
        "logos_title": {
            "type": "text",
            "label": "Logos Section Title",
            "default": "Trusted by Leading Companies"
        },
        "logos_subtitle": {
            "type": "textarea",
            "label": "Logos Section Subtitle",
            "default": "Join thousands of satisfied clients worldwide"
        },
        "logos_style": {
            "type": "select",
            "label": "Logos Display Style",
            "default": "grid",
            "options": {
                "grid": "Grid Layout",
                "carousel": "Carousel Slider"
            }
        },
        "logos_count": {
            "type": "select",
            "label": "Number of Logos",
            "default": "6",
            "options": {
                "4": "4 Logos",
                "6": "6 Logos",
                "8": "8 Logos",
                "12": "12 Logos"
            }
        },
        "logos_per_row": {
            "type": "select",
            "label": "Logos Per Row",
            "default": "4",
            "options": {
                "3": "3 Per Row",
                "4": "4 Per Row",
                "5": "5 Per Row",
                "6": "6 Per Row"
            }
        },
        "logos_grayscale": {
            "type": "checkbox",
            "label": "Grayscale Logos",
            "default": true,
            "checkbox_label": "Show logos in grayscale (color on hover)"
        },
        "carousel_autoplay": {
            "type": "checkbox",
            "label": "Carousel Autoplay",
            "default": true,
            "checkbox_label": "Enable automatic carousel rotation"
        },
        "carousel_speed": {
            "type": "select",
            "label": "Carousel Speed",
            "default": "3000",
            "options": {
                "2000": "2 seconds",
                "3000": "3 seconds",
                "4000": "4 seconds",
                "5000": "5 seconds"
            }
        },
        "show_logo": {
            "type": "checkbox",
            "label": "Show Logo",
            "default": true,
            "checkbox_label": "Display logo in footer"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        },
        "show_contact": {
            "type": "checkbox",
            "label": "Show Contact Info",
            "default": true,
            "checkbox_label": "Display contact information"
        },
        "columns": {
            "type": "select",
            "label": "Number of Columns",
            "default": "4",
            "options": {
                "2": "2 Columns",
                "3": "3 Columns",
                "4": "4 Columns"
            }
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "Show Copyright",
            "default": true,
            "checkbox_label": "Display copyright text"
        },
        "copyright_text": {
            "type": "text",
            "label": "Custom Copyright Text",
            "default": "All rights reserved."
        }
    }
}
