{
    "name": "timeline",
    "title": "Timeline Footer",
    "description": "Footer with company timeline/history showing milestones and achievements",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        "timeline_bg": {
            "type": "color",
            "label": "Timeline Section Background",
            "default": "#f9fafb"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#6b7280"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#111827"
        },
        "accent_color": {
            "type": "color",
            "label": "Accent Color",
            "default": "#8b5cf6"
        },
        "timeline_line_color": {
            "type": "color",
            "label": "Timeline Line Color",
            "default": "#d1d5db"
        },
        "show_timeline": {
            "type": "checkbox",
            "label": "Show Timeline",
            "default": true,
            "checkbox_label": "Display company timeline section"
        },
        "timeline_title": {
            "type": "text",
            "label": "Timeline Title",
            "default": "Our Journey"
        },
        "timeline_subtitle": {
            "type": "textarea",
            "label": "Timeline Subtitle",
            "default": "Building excellence since day one"
        },
        "timeline_style": {
            "type": "select",
            "label": "Timeline Style",
            "default": "horizontal",
            "options": {
                "horizontal": "Horizontal Timeline",
                "vertical": "Vertical Timeline"
            }
        },
        "milestones_count": {
            "type": "select",
            "label": "Number of Milestones",
            "default": "4",
            "options": {
                "3": "3 Milestones",
                "4": "4 Milestones",
                "5": "5 Milestones",
                "6": "6 Milestones"
            }
        },
        "show_year": {
            "type": "checkbox",
            "label": "Show Years",
            "default": true,
            "checkbox_label": "Display year markers"
        },
        "show_icons": {
            "type": "checkbox",
            "label": "Show Icons",
            "default": true,
            "checkbox_label": "Display milestone icons"
        },
        "animate_timeline": {
            "type": "checkbox",
            "label": "Animate Timeline",
            "default": true,
            "checkbox_label": "Enable scroll animations"
        },
        "show_logo": {
            "type": "checkbox",
            "label": "Show Logo",
            "default": true,
            "checkbox_label": "Display logo in footer"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        },
        "show_contact": {
            "type": "checkbox",
            "label": "Show Contact Info",
            "default": true,
            "checkbox_label": "Display contact information"
        },
        "columns": {
            "type": "select",
            "label": "Number of Columns",
            "default": "3",
            "options": {
                "2": "2 Columns",
                "3": "3 Columns",
                "4": "4 Columns"
            }
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "Show Copyright",
            "default": true,
            "checkbox_label": "Display copyright text"
        },
        "copyright_text": {
            "type": "text",
            "label": "Custom Copyright Text",
            "default": "All rights reserved."
        }
    }
}
