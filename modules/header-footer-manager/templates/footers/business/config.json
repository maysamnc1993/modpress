{
    "name": "business",
    "title": "Business Professional",
    "description": "Professional 4-column footer with logo, about, services menu, contact info, and newsletter signup",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#1e293b"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#94a3b8"
        },
        "link_color": {
            "type": "color",
            "label": "Link Color",
            "default": "#ffffff"
        },
        "link_hover_color": {
            "type": "color",
            "label": "Link Hover Color",
            "default": "#3b82f6"
        },
        "show_logo": {
            "type": "checkbox",
            "label": "Show Logo",
            "default": true,
            "checkbox_label": "Display logo in footer"
        },
        "show_description": {
            "type": "checkbox",
            "label": "Show Description",
            "default": true,
            "checkbox_label": "Display site description"
        },
        "description_text": {
            "type": "textarea",
            "label": "Custom Description",
            "default": "We are a professional business providing high-quality services to our clients worldwide."
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        },
        "show_newsletter": {
            "type": "checkbox",
            "label": "Show Newsletter",
            "default": true,
            "checkbox_label": "Display newsletter signup form"
        },
        "newsletter_title": {
            "type": "text",
            "label": "Newsletter Title",
            "default": "Subscribe to Newsletter"
        },
        "newsletter_text": {
            "type": "text",
            "label": "Newsletter Description",
            "default": "Get the latest updates and offers directly in your inbox."
        },
        "show_contact": {
            "type": "checkbox",
            "label": "Show Contact Info",
            "default": true,
            "checkbox_label": "Display contact information"
        },
        "columns": {
            "type": "select",
            "label": "Number of Columns",
            "default": "4",
            "options": {
                "2": "2 Columns",
                "3": "3 Columns",
                "4": "4 Columns",
                "5": "5 Columns"
            }
        },
        "show_menu1": {
            "type": "checkbox",
            "label": "Show Services Menu",
            "default": true,
            "checkbox_label": "Display services menu column"
        },
        "menu1_title": {
            "type": "text",
            "label": "Services Menu Title",
            "default": "Our Services"
        },
        "show_menu2": {
            "type": "checkbox",
            "label": "Show Company Menu",
            "default": true,
            "checkbox_label": "Display company menu column"
        },
        "menu2_title": {
            "type": "text",
            "label": "Company Menu Title",
            "default": "Company"
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "Show Copyright",
            "default": true,
            "checkbox_label": "Display copyright text"
        },
        "copyright_text": {
            "type": "text",
            "label": "Custom Copyright Text",
            "default": "All rights reserved."
        },
        "show_payment_icons": {
            "type": "checkbox",
            "label": "Show Payment Icons",
            "default": false,
            "checkbox_label": "Display payment method icons"
        },
        "show_back_to_top": {
            "type": "checkbox",
            "label": "Show Back to Top",
            "default": true,
            "checkbox_label": "Display back to top button"
        }
    }
}
