{
    "name": "split-color",
    "title": "Split Color Footer",
    "description": "Unique split color design with content flowing across divided sections",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "split_style": {
            "type": "select",
            "label": "Split Style",
            "default": "diagonal",
            "options": {
                "vertical": "Vertical Split (50/50)",
                "diagonal": "Diagonal Split",
                "curved": "Curved Split",
                "zigzag": "Zigzag Split",
                "asymmetric": "Asymmetric (60/40)"
            }
        },
        "left_color": {
            "type": "color",
            "label": "Left Side Color",
            "default": "#1e293b"
        },
        "right_color": {
            "type": "color",
            "label": "Right Side Color",
            "default": "#3b82f6"
        },
        "text_color_left": {
            "type": "color",
            "label": "Text Color (Left Side)",
            "default": "#ffffff"
        },
        "text_color_right": {
            "type": "color",
            "label": "Text Color (Right Side)",
            "default": "#ffffff"
        },
        "heading_color_left": {
            "type": "color",
            "label": "Heading Color (Left Side)",
            "default": "#ffffff"
        },
        "heading_color_right": {
            "type": "color",
            "label": "Heading Color (Right Side)",
            "default": "#ffffff"
        },
        "show_divider": {
            "type": "checkbox",
            "label": "Show Divider Line",
            "default": true,
            "checkbox_label": "Display divider line at split"
        },
        "divider_color": {
            "type": "color",
            "label": "Divider Color",
            "default": "#ffffff"
        },
        "divider_opacity": {
            "type": "select",
            "label": "Divider Opacity",
            "default": "30",
            "options": {
                "10": "10%",
                "20": "20%",
                "30": "30%",
                "50": "50%",
                "100": "100%"
            }
        },
        "show_cta": {
            "type": "checkbox",
            "label": "Show CTA Button",
            "default": true,
            "checkbox_label": "Display call-to-action button"
        },
        "cta_text": {
            "type": "text",
            "label": "CTA Button Text",
            "default": "Get Started"
        },
        "cta_url": {
            "type": "url",
            "label": "CTA Button URL",
            "default": "/contact"
        },
        "bottom_bg_color": {
            "type": "color",
            "label": "Bottom Bar Background Color",
            "default": "#0f172a"
        },
        "bottom_text_color": {
            "type": "color",
            "label": "Bottom Bar Text Color",
            "default": "#94a3b8"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        }
    }
}
