{
    "name": "contact",
    "title": "تماس",
    "description": "فوتر با اطلاعات تماس برجسته - تلفن، ایمیل و آدرس",
    "version": "1.0.0",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
