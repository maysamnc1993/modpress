{
    "name": "restaurant",
    "title": "فوتر رستوران",
    "description": "فوتر رستوران با ساعات کاری، موقعیت مکانی با نقشه، CTA رزرو، منوی ویژه و فید اینستاگرام",
    "version": "1.0.0",
    "author": "Developer Starter",
    "supports": ["hours", "location", "reservation", "menu-highlights", "instagram-feed"],
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "رنگ پس‌زمینه",
            "default": "#1c1917"
        },
        "text_color": {
            "type": "color",
            "label": "رنگ متن",
            "default": "#fafaf9"
        },
        "link_color": {
            "type": "color",
            "label": "رنگ لینک",
            "default": "#d6d3d1"
        },
        "link_hover_color": {
            "type": "color",
            "label": "رنگ لینک در هاور",
            "default": "#fbbf24"
        },
        "show_logo": {
            "type": "checkbox",
            "label": "نمایش لوگو",
            "default": true,
            "checkbox_label": "نمایش لوگوی رستوران"
        },
        "show_description": {
            "type": "checkbox",
            "label": "نمایش توضیحات",
            "default": true,
            "checkbox_label": "نمایش متن توضیحات"
        },
        "description_text": {
            "type": "textarea",
            "label": "متن توضیحات",
            "default": "تجربه‌ای منحصر به فرد از طعم‌های اصیل و محیطی دلنشین. ما افتخار می‌کنیم که بهترین غذاها را با مواد اولیه تازه به شما ارائه دهیم."
        },
        "show_social": {
            "type": "checkbox",
            "label": "نمایش شبکه‌های اجتماعی",
            "default": true,
            "checkbox_label": "نمایش آیکون‌های شبکه‌های اجتماعی"
        },
        "show_newsletter": {
            "type": "checkbox",
            "label": "نمایش خبرنامه",
            "default": false,
            "checkbox_label": "نمایش فرم ثبت‌نام خبرنامه"
        },
        "newsletter_title": {
            "type": "text",
            "label": "عنوان خبرنامه",
            "default": "پیشنهادات ویژه"
        },
        "newsletter_text": {
            "type": "text",
            "label": "متن خبرنامه",
            "default": "تخفیف‌ها و منوهای ویژه را دریافت کنید"
        },
        "show_contact": {
            "type": "checkbox",
            "label": "نمایش اطلاعات تماس",
            "default": true,
            "checkbox_label": "نمایش تلفن، آدرس و ایمیل"
        },
        "columns": {
            "type": "select",
            "label": "تعداد ستون‌ها",
            "options": {
                "2": "2 ستون",
                "3": "3 ستون",
                "4": "4 ستون",
                "5": "5 ستون"
            },
            "default": "4"
        },
        "show_menu1": {
            "type": "checkbox",
            "label": "نمایش منوی اول",
            "default": true,
            "checkbox_label": "نمایش منوی لینک‌ها"
        },
        "menu1_title": {
            "type": "text",
            "label": "عنوان منوی اول",
            "default": "لینک‌های مفید"
        },
        "show_menu2": {
            "type": "checkbox",
            "label": "نمایش منوی دوم",
            "default": false,
            "checkbox_label": "نمایش منوی دوم"
        },
        "menu2_title": {
            "type": "text",
            "label": "عنوان منوی دوم",
            "default": "خدمات"
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "نمایش کپی‌رایت",
            "default": true,
            "checkbox_label": "نمایش متن کپی‌رایت"
        },
        "copyright_text": {
            "type": "text",
            "label": "متن کپی‌رایت",
            "default": "تمامی حقوق محفوظ است"
        },
        "show_payment_icons": {
            "type": "checkbox",
            "label": "نمایش آیکون‌های پرداخت",
            "default": true,
            "checkbox_label": "نمایش لوگوهای روش‌های پرداخت"
        },
        "show_back_to_top": {
            "type": "checkbox",
            "label": "نمایش دکمه بازگشت به بالا",
            "default": true,
            "checkbox_label": "نمایش دکمه اسکرول به بالا"
        },
        "show_hours": {
            "type": "checkbox",
            "label": "نمایش ساعات کاری",
            "default": true,
            "checkbox_label": "نمایش جدول ساعات کاری"
        },
        "hours_title": {
            "type": "text",
            "label": "عنوان ساعات کاری",
            "default": "ساعات کاری"
        },
        "show_location": {
            "type": "checkbox",
            "label": "نمایش موقعیت مکانی",
            "default": true,
            "checkbox_label": "نمایش آدرس و نقشه"
        },
        "location_title": {
            "type": "text",
            "label": "عنوان موقعیت",
            "default": "آدرس ما"
        },
        "show_reservation": {
            "type": "checkbox",
            "label": "نمایش دکمه رزرو",
            "default": true,
            "checkbox_label": "نمایش دکمه CTA رزرو میز"
        },
        "reservation_text": {
            "type": "text",
            "label": "متن دکمه رزرو",
            "default": "رزرو میز"
        },
        "reservation_url": {
            "type": "url",
            "label": "لینک رزرو",
            "default": "/reservation"
        },
        "show_menu_highlights": {
            "type": "checkbox",
            "label": "نمایش منوی ویژه",
            "default": true,
            "checkbox_label": "نمایش غذاهای ویژه"
        },
        "menu_highlights_title": {
            "type": "text",
            "label": "عنوان منوی ویژه",
            "default": "غذاهای ویژه"
        },
        "show_instagram": {
            "type": "checkbox",
            "label": "نمایش فید اینستاگرام",
            "default": true,
            "checkbox_label": "نمایش پست‌های اینستاگرام"
        },
        "instagram_title": {
            "type": "text",
            "label": "عنوان اینستاگرام",
            "default": "ما را در اینستاگرام دنبال کنید"
        },
        "accent_color": {
            "type": "color",
            "label": "رنگ تاکیدی",
            "default": "#fbbf24"
        }
    }
}
