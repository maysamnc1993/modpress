{
    "name": "modern",
    "title": "Clean Modern",
    "description": "Clean modern 3-column footer with large newsletter section, social icons, and minimal links",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#0f172a"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#cbd5e1"
        },
        "link_color": {
            "type": "color",
            "label": "Link Color",
            "default": "#f1f5f9"
        },
        "link_hover_color": {
            "type": "color",
            "label": "Link Hover Color",
            "default": "#06b6d4"
        },
        "show_logo": {
            "type": "checkbox",
            "label": "Show Logo",
            "default": true,
            "checkbox_label": "Display logo in footer"
        },
        "show_description": {
            "type": "checkbox",
            "label": "Show Description",
            "default": true,
            "checkbox_label": "Display site description"
        },
        "description_text": {
            "type": "textarea",
            "label": "Custom Description",
            "default": "Creating beautiful digital experiences that inspire and engage."
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        },
        "show_newsletter": {
            "type": "checkbox",
            "label": "Show Newsletter",
            "default": true,
            "checkbox_label": "Display newsletter signup form"
        },
        "newsletter_title": {
            "type": "text",
            "label": "Newsletter Title",
            "default": "Stay Updated"
        },
        "newsletter_text": {
            "type": "text",
            "label": "Newsletter Description",
            "default": "Join our community and never miss out on the latest news and updates."
        },
        "show_contact": {
            "type": "checkbox",
            "label": "Show Contact Info",
            "default": false,
            "checkbox_label": "Display contact information"
        },
        "columns": {
            "type": "select",
            "label": "Number of Columns",
            "default": "3",
            "options": {
                "2": "2 Columns",
                "3": "3 Columns",
                "4": "4 Columns",
                "5": "5 Columns"
            }
        },
        "show_menu1": {
            "type": "checkbox",
            "label": "Show Quick Links Menu",
            "default": true,
            "checkbox_label": "Display quick links menu column"
        },
        "menu1_title": {
            "type": "text",
            "label": "Quick Links Menu Title",
            "default": "Quick Links"
        },
        "show_menu2": {
            "type": "checkbox",
            "label": "Show Resources Menu",
            "default": true,
            "checkbox_label": "Display resources menu column"
        },
        "menu2_title": {
            "type": "text",
            "label": "Resources Menu Title",
            "default": "Resources"
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "Show Copyright",
            "default": true,
            "checkbox_label": "Display copyright text"
        },
        "copyright_text": {
            "type": "text",
            "label": "Custom Copyright Text",
            "default": "All rights reserved."
        },
        "show_payment_icons": {
            "type": "checkbox",
            "label": "Show Payment Icons",
            "default": false,
            "checkbox_label": "Display payment method icons"
        },
        "show_back_to_top": {
            "type": "checkbox",
            "label": "Show Back to Top",
            "default": true,
            "checkbox_label": "Display back to top button"
        }
    }
}
