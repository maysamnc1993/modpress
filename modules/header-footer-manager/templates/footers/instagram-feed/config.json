{
    "name": "instagram-feed",
    "title": "Instagram Feed Footer",
    "description": "Footer with Instagram feed grid and follow CTA",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#fafafa"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#262626"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#000000"
        },
        "accent_color": {
            "type": "color",
            "label": "Accent Color",
            "default": "#e4405f"
        },
        "border_color": {
            "type": "color",
            "label": "Border Color",
            "default": "#dbdbdb"
        },
        "instagram_handle": {
            "type": "text",
            "label": "Instagram Handle",
            "default": "@yourcompany"
        },
        "instagram_url": {
            "type": "text",
            "label": "Instagram Profile URL",
            "default": "https://instagram.com/yourcompany"
        },
        "images_count": {
            "type": "number",
            "label": "Number of Images",
            "default": "8",
            "min": "4",
            "max": "12"
        },
        "grid_columns": {
            "type": "select",
            "label": "Grid Columns",
            "default": "4",
            "options": {
                "3": "3 Columns",
                "4": "4 Columns",
                "6": "6 Columns"
            }
        },
        "show_follow_button": {
            "type": "checkbox",
            "label": "Show Follow Button",
            "default": true,
            "checkbox_label": "Display follow CTA button"
        },
        "follow_button_text": {
            "type": "text",
            "label": "Follow Button Text",
            "default": "Follow Us on Instagram"
        },
        "section_heading": {
            "type": "text",
            "label": "Section Heading",
            "default": "Follow Our Journey"
        },
        "section_description": {
            "type": "textarea",
            "label": "Section Description",
            "default": "Stay updated with our latest products, behind-the-scenes, and inspiration on Instagram."
        },
        "show_logo": {
            "type": "checkbox",
            "label": "Show Logo",
            "default": true,
            "checkbox_label": "Display logo in footer"
        },
        "show_menu": {
            "type": "checkbox",
            "label": "Show Footer Menu",
            "default": true,
            "checkbox_label": "Display footer navigation menu"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Other Social Icons",
            "default": true,
            "checkbox_label": "Display other social media icons"
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "Show Copyright",
            "default": true,
            "checkbox_label": "Display copyright text"
        },
        "copyright_text": {
            "type": "text",
            "label": "Custom Copyright Text",
            "default": "All rights reserved."
        },
        "image_border_radius": {
            "type": "select",
            "label": "Image Border Radius",
            "default": "small",
            "options": {
                "none": "None (Square)",
                "small": "Small Rounded",
                "medium": "Medium Rounded",
                "large": "Large Rounded"
            }
        },
        "hover_effect": {
            "type": "select",
            "label": "Image Hover Effect",
            "default": "zoom",
            "options": {
                "none": "None",
                "zoom": "Zoom In",
                "fade": "Fade Overlay",
                "lift": "Lift Up"
            }
        }
    }
}
