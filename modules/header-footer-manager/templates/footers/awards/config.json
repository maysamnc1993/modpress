{
    "name": "awards",
    "title": "Awards Footer",
    "description": "Footer showcasing awards, certificates, and achievements",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        "awards_bg": {
            "type": "color",
            "label": "Awards Section Background",
            "default": "#fafaf9"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#57534e"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#1c1917"
        },
        "accent_color": {
            "type": "color",
            "label": "Accent Color",
            "default": "#f59e0b"
        },
        "badge_bg": {
            "type": "color",
            "label": "Award Badge Background",
            "default": "#fffbeb"
        },
        "show_awards": {
            "type": "checkbox",
            "label": "Show Awards",
            "default": true,
            "checkbox_label": "Display awards section"
        },
        "awards_title": {
            "type": "text",
            "label": "Awards Title",
            "default": "Awards & Recognition"
        },
        "awards_subtitle": {
            "type": "textarea",
            "label": "Awards Subtitle",
            "default": "Recognized for excellence and innovation"
        },
        "awards_layout": {
            "type": "select",
            "label": "Awards Layout",
            "default": "grid",
            "options": {
                "row": "Single Row",
                "grid": "Grid Layout"
            }
        },
        "awards_count": {
            "type": "select",
            "label": "Number of Awards",
            "default": "6",
            "options": {
                "4": "4 Awards",
                "6": "6 Awards",
                "8": "8 Awards"
            }
        },
        "awards_per_row": {
            "type": "select",
            "label": "Awards Per Row",
            "default": "3",
            "options": {
                "2": "2 Per Row",
                "3": "3 Per Row",
                "4": "4 Per Row",
                "6": "6 Per Row"
            }
        },
        "show_award_names": {
            "type": "checkbox",
            "label": "Show Award Names",
            "default": true,
            "checkbox_label": "Display award titles and years"
        },
        "show_award_icons": {
            "type": "checkbox",
            "label": "Show Award Icons",
            "default": true,
            "checkbox_label": "Display award badge icons"
        },
        "awards_animate": {
            "type": "checkbox",
            "label": "Animate Awards",
            "default": true,
            "checkbox_label": "Enable hover animations"
        },
        "show_logo": {
            "type": "checkbox",
            "label": "Show Logo",
            "default": true,
            "checkbox_label": "Display logo in footer"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        },
        "show_contact": {
            "type": "checkbox",
            "label": "Show Contact Info",
            "default": true,
            "checkbox_label": "Display contact information"
        },
        "columns": {
            "type": "select",
            "label": "Number of Columns",
            "default": "4",
            "options": {
                "2": "2 Columns",
                "3": "3 Columns",
                "4": "4 Columns"
            }
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "Show Copyright",
            "default": true,
            "checkbox_label": "Display copyright text"
        },
        "copyright_text": {
            "type": "text",
            "label": "Custom Copyright Text",
            "default": "All rights reserved."
        }
    }
}
