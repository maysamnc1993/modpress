{
    "name": "cta-large",
    "title": "Large CTA Footer",
    "description": "Footer with prominent call-to-action section and dual buttons",
    "version": "1.0.0",
    "author": "Developer Starter",
    "settings": {
        "bg_color": {
            "type": "color",
            "label": "Background Color",
            "default": "#111827"
        },
        "cta_bg_color": {
            "type": "color",
            "label": "CTA Section Background",
            "default": "#1f2937"
        },
        "text_color": {
            "type": "color",
            "label": "Text Color",
            "default": "#9ca3af"
        },
        "heading_color": {
            "type": "color",
            "label": "Heading Color",
            "default": "#ffffff"
        },
        "primary_color": {
            "type": "color",
            "label": "Primary Button Color",
            "default": "#10b981"
        },
        "secondary_color": {
            "type": "color",
            "label": "Secondary Button Color",
            "default": "#6b7280"
        },
        "cta_heading": {
            "type": "text",
            "label": "CTA Heading",
            "default": "Ready to Get Started?"
        },
        "cta_subheading": {
            "type": "text",
            "label": "CTA Subheading",
            "default": "Join thousands of satisfied customers"
        },
        "cta_text": {
            "type": "textarea",
            "label": "CTA Description",
            "default": "Transform your business with our cutting-edge solutions. Start your free trial today and experience the difference."
        },
        "primary_btn_text": {
            "type": "text",
            "label": "Primary Button Text",
            "default": "Start Free Trial"
        },
        "primary_btn_url": {
            "type": "text",
            "label": "Primary Button URL",
            "default": "/signup"
        },
        "secondary_btn_text": {
            "type": "text",
            "label": "Secondary Button Text",
            "default": "View Pricing"
        },
        "secondary_btn_url": {
            "type": "text",
            "label": "Secondary Button URL",
            "default": "/pricing"
        },
        "show_features": {
            "type": "checkbox",
            "label": "Show Feature Highlights",
            "default": true,
            "checkbox_label": "Display feature checkmarks below CTA"
        },
        "show_logo": {
            "type": "checkbox",
            "label": "Show Logo",
            "default": true,
            "checkbox_label": "Display logo in footer"
        },
        "show_menu": {
            "type": "checkbox",
            "label": "Show Footer Menu",
            "default": true,
            "checkbox_label": "Display footer navigation menu"
        },
        "show_contact": {
            "type": "checkbox",
            "label": "Show Contact Info",
            "default": true,
            "checkbox_label": "Display contact information"
        },
        "show_social": {
            "type": "checkbox",
            "label": "Show Social Icons",
            "default": true,
            "checkbox_label": "Display social media icons"
        },
        "show_copyright": {
            "type": "checkbox",
            "label": "Show Copyright",
            "default": true,
            "checkbox_label": "Display copyright text"
        },
        "copyright_text": {
            "type": "text",
            "label": "Custom Copyright Text",
            "default": "All rights reserved."
        },
        "cta_style": {
            "type": "select",
            "label": "CTA Style",
            "default": "gradient",
            "options": {
                "solid": "Solid Background",
                "gradient": "Gradient Background",
                "bordered": "Bordered Card"
            }
        }
    }
}
